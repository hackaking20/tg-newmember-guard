# --- Main guard bot (required) ---------------------------------------------
BOT_TOKEN=123456:ABC-your-botfather-token
# Chat where quarantine notifications + buttons go.
# Your own DM: message @userinfobot to get your numeric id.
# A private admin group: add the bot there, it prints the id on startup.
ADMIN_CHAT_ID=-1001234567890
# Your admins, comma separated (can press buttons / use commands)
ADMIN_IDS=123456789,987654321

# --- Moderation policy ------------------------------------------------------
# The group to moderate. 0 = every group the bot is in.
GROUP_ID=-1001234567890
# Accounts estimated younger than this many days get quarantined.
MIN_ACCOUNT_AGE_DAYS=30
# Members who have sent this many clean messages are never bothered.
TRUST_AFTER_MESSAGES=10
# 1 = old-looking accounts pass instantly, 0 = quarantine EVERY new joiner
AUTO_PASS_OLD_ACCOUNTS=1
# 1 = after approval, re-post the user's held messages into the group
REPOST_HELD=1
# DB_PATH=guard.db

# --- Bio guard userbot (optional, needs your own account) -------------------
# Values from https://my.telegram.org (API development tools)
TELETHON_API_ID=1234567
TELETHON_API_HASH=abcdef1234567890abcdef1234567890
# Same bot token as above (used to mute + notify)
GUARD_BOT_TOKEN=123456:ABC-your-botfather-token
# Extra bio spam patterns, regex, pipe-separated. Defaults already catch
# any URL / t.me link / common promo keywords.
# BIO_SPAM_PATTERNS=somechannel|anotherword
# 1 = log every join's bio to the admin chat (noisy, useful while tuning)
# LOG_ALL_JOINS=0
